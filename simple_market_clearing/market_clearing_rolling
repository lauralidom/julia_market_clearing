using YAML
using JuMP
using HiGHS
using Plots
using Statistics

# ============================================================================
# SECTION 1: LOAD INPUT DATA
# ============================================================================

function load_input_data(path::String)
    # Read the YAML file into a nested Julia Dict/Array structure
    cfg = YAML.load_file(path)

    # Internal data dictionary to pass to the other functions
    data = Dict{Symbol,Any}()

    # generators: separate blocks for dispatchable and variable generators
    data[:dispatchableGenerators] = cfg["dispatchableGenerators"]
    data[:variableGenerators]     = get(cfg, "variableGenerators", Dict())

    # demand segments: Base and Flex demand, each with a bid and hourly quantities
    data[:demandSegments] = cfg["demand"]["segments"]

    # storage parameters
    data[:batteryStorage] = get(cfg, "batteryStorage", nothing)


    return data
end

# ============================================================================
# SECTION 2: MODEL SETUP AND FUNCTIONS
# ============================================================================

# 2.1: Define Sets (indices for generators, demand, time periods)
function define_sets!(m::Model, data::Dict{Symbol,Any})
    # Store all sets in a dedicated dictionary attached to the model
    m.ext[:sets] = Dict{Symbol,Any}()

    disp_gen = data[:dispatchableGenerators]
    var_gen  = data[:variableGenerators]
    dem      = data[:demandSegments]

    # Note: JH (time periods) is now set dynamically in rolling horizon loop
    # Will be overwritten to 1:look_ahead during each iteration

    # generators IG = list of all generator names (dispatchable + variable)
    IG = String[]
    for g in keys(disp_gen)
        push!(IG, String(g))
    end
    for g in keys(var_gen)
        push!(IG, String(g))
    end
    m.ext[:sets][:IG] = IG

    # demand segments ID = list of all demand segment names (Base, Flex)
    ID = String[]
    for d in keys(dem)
        push!(ID, String(d))
    end
    m.ext[:sets][:ID] = ID

    return m
end

# 2.2: Load and Expand Time Series (process input data for full simulation horizon)
function load_and_expand_timeseries(cfg::Dict, total_hours::Int)
    """
    Load input data from YAML and expand to full simulation horizon.
    Returns dictionaries with time series for all hours.
    """
    
    disp_gen = cfg["dispatchableGenerators"]
    var_gen = cfg["variableGenerators"]
    dem = cfg["demand"]["segments"]
    
    # Initialize dictionaries
    Pr_gen_full = Dict{Tuple{String,Int},Float64}()
    Q_gen_full = Dict{Tuple{String,Int},Float64}()
    Pr_dem_full = Dict{Tuple{String,Int},Float64}()
    Q_dem_full = Dict{Tuple{String,Int},Float64}()
    
    # Dispatchable generators: constant price and capacity across all hours
    for (gname, gdata_any) in disp_gen
        g = String(gname)
        P = float(gdata_any["bidPrice"])
        Q = float(gdata_any["capacity"])
        for h in 1:total_hours
            Pr_gen_full[(g, h)] = P
            Q_gen_full[(g, h)] = Q
        end
    end
    
    # Variable generators: expand profile cyclically across all hours
    for (gname, gdata_any) in var_gen
        g = String(gname)
        P = float(gdata_any["bidPrice"])
        Q = float(gdata_any["capacity"])
        profile_any = gdata_any["profile"]
        profile = [float(x) for x in profile_any]
        daily_length = length(profile)
        
        for h in 1:total_hours
            hour_in_day = mod(h - 1, daily_length) + 1
            af = profile[hour_in_day]
            Pr_gen_full[(g, h)] = P
            Q_gen_full[(g, h)] = Q * af
        end
    end
    
    # Demand segments: expand quantities cyclically across all hours
    for (dname, ddata_any) in dem
        d = String(dname)
        P = float(ddata_any["bidPrice"])
        q_any = ddata_any["quantity"]
        q_vec = [float(x) for x in q_any]
        daily_length = length(q_vec)
        
        for h in 1:total_hours
            hour_in_day = mod(h - 1, daily_length) + 1
            Pr_dem_full[(d, h)] = P
            Q_dem_full[(d, h)] = q_vec[hour_in_day]
        end
    end
    
    return Pr_gen_full, Q_gen_full, Pr_dem_full, Q_dem_full
end

# 2.3 Extract Rolling Window from Full Time Series
function get_window_timeseries(Pr_gen_full, Q_gen_full, Pr_dem_full, Q_dem_full, 
                                start_hour::Int, window_length::Int, 
                                IG::Vector, ID::Vector)
    """
    Extract time series for hours [start_hour, start_hour + window_length - 1]
    and reindex to JH = 1:window_length
    """
    
    Pr_gen_window = Dict{Tuple{String,Int},Float64}()
    Q_gen_window = Dict{Tuple{String,Int},Float64}()
    Pr_dem_window = Dict{Tuple{String,Int},Float64}()
    Q_dem_window = Dict{Tuple{String,Int},Float64}()
    
    for h_model in 1:window_length
        h_global = start_hour + h_model - 1
        
        for g in IG
            Pr_gen_window[(g, h_model)] = Pr_gen_full[(g, h_global)]
            Q_gen_window[(g, h_model)] = Q_gen_full[(g, h_global)]
        end
        
        for d in ID
            Pr_dem_window[(d, h_model)] = Pr_dem_full[(d, h_global)]
            Q_dem_window[(d, h_model)] = Q_dem_full[(d, h_global)]
        end
    end
    
    return Pr_gen_window, Q_gen_window, Pr_dem_window, Q_dem_window
end

# 2.4 Add Wind Forecast Noise (simulate forecast uncertainty)
function add_wind_forecast_noise!(Q_gen_window::Dict, cfg::Dict, noise_std::Float64, 
                                   IG::Vector, window_length::Int)
    """
    Add random noise to wind generation forecast to simulate forecast errors.
    Noise is normally distributed with standard deviation from input_data.yaml
    """
    
    if noise_std == 0.0
        return  # no noise
    end
    
    var_gen = cfg["variableGenerators"]
    
    for (gname, gdata_any) in var_gen
        g = String(gname)
        if g in IG
            Q = float(gdata_any["capacity"])
            
            for h in 1:window_length
                # Current forecast (availability factor)
                current_af = Q_gen_window[(g, h)] / Q
                
                # Add Gaussian noise
                noise = randn() * noise_std
                new_af = clamp(current_af + noise, 0.0, 1.0)
                
                Q_gen_window[(g, h)] = Q * new_af
            end
        end
    end
end

# 2.5 Extract All Window Hours as Commitments (for next window)
function extract_window_commitments(Qg_val, IG::Vector, window_length::Int)
    """
    Extract dispatch for ALL hours in the window as commitments for next window.
    These are financially settled and can be adjusted (bought back) in subsequent clearings.
    
    Returns dict with all hours: commitments[(g, h)] for h in 1:window_length
    """
    
    commitments = Dict{Tuple{String,Int},Float64}()
    
    for g in IG
        for h in 1:window_length
            # Store all hours as commitments
            commitments[(g, h)] = Qg_val[g, h]
        end
    end
    
    return commitments
end

# 2.6 Prepare Previous Commitments (shift window forward)
function prepare_Q_prev_for_next_window(prev_commitments::Dict, window_length::Int, IG::Vector)
    """
    Build Q_prev baseline for the next window by rolling forward all commitments.
    
    When rolling from one window to the next:
    - Previous hours 2-24 become new hours 1-23 (Q_prev carries them forward)
    - New hour 24 enters with no prior commitment (Q_prev[g,24] = 0)
    
    In the model, Q_phys[g,h] = Q_prev[g,h] + Qg[g,h] where Qg is the adjustment.
    Hour 1: Qg[g,1] forced to 0, so Q_phys[g,1] = Q_prev[g,1] (locked to previous h=2)
    Hours 2-23: Qg can adjust from their Q_prev baseline (previous h=3-24)
    Hour 24: Qg fully free since Q_prev[g,24] = 0
    """
    
    Q_prev = Dict{Tuple{String,Int},Float64}()
    
    for g in IG
        for h in 1:window_length
            if h < window_length
                # Hours 1-(L-1): shift forward from previous window
                # h becomes h+1 from previous clearing
                Q_prev[(g, h)] = prev_commitments[(g, h + 1)]
            else
                # Last hour (new hour entering): no prior commitment
                Q_prev[(g, h)] = 0.0
            end
        end
    end
    
    return Q_prev
end
    
    return Q_prev
end


# 2.7: Process Parameters (storage, solver settings)
function process_parameters!(m::Model, data::Dict{Symbol,Any})
    
    m.ext[:parameters] = Dict{Symbol,Any}()

    # Store storage parameters
    if data[:batteryStorage] !== nothing
        storage = data[:batteryStorage]
        m.ext[:parameters][:storage_energy_capacity] = float(storage["energyCapacity"])
        m.ext[:parameters][:storage_power_capacity] = float(storage["powerCapacity"])
        m.ext[:parameters][:storage_efficiency] = float(storage["efficiency"])
        m.ext[:parameters][:storage_initial_soc] = float(storage["initialSOC"]) * float(storage["energyCapacity"])
        m.ext[:parameters][:has_storage] = true
    else
        m.ext[:parameters][:has_storage] = false
    end
    
    return m
end

# ============================================================================
# SECTION 3: MARKET CLEARING MODEL BUILDER
# ============================================================================

# 3.1: Build Market Clearing Model (sets up variables, constraints, objective)
function build_market_clearing!(m::Model)
    """
    Rolling intraday market clearing model.
    
    SEMANTICS:
    - Qg[g,h] = adjustment to previous commitment (can be negative)
    - Q_phys[g,h] = Q_prev[g,h] + Qg[g,h] = actual physical dispatch
    - Hour 1: Qg[g,1] == 0 (locked to Q_prev, no adjustment)
    - Hours 2+: Qg can be negative (reduce output) or positive (increase output)
    - All settlement at current market clearing price λ(h)
    - Generators can "buy back" position by reducing output in subsequent clearings
    """
    
    m.ext[:variables]   = Dict{Symbol,Any}()
    m.ext[:expressions] = Dict{Symbol,Any}()
    m.ext[:constraints] = Dict{Symbol,Any}()

    # load sets and time series from previous steps
    JH = m.ext[:sets][:JH]
    IG = m.ext[:sets][:IG]
    ID = m.ext[:sets][:ID]

    Pr_gen = m.ext[:timeseries][:Pr_gen]
    Q_gen  = m.ext[:timeseries][:Q_gen]
    Pr_dem = m.ext[:timeseries][:Pr_dem]
    Q_dem  = m.ext[:timeseries][:Q_dem]
    Q_prev = m.ext[:timeseries][:Q_prev]


    # decision variables:
    # Qd[d,h] = served demand of segment d in hour h [MW]
    Qd = m.ext[:variables][:Qd] = @variable(m, Qd[d in ID, h in JH] >= 0)
    # Qg[g,h] = adjustment to previous commitment for generator g in hour h [MW]
    # Qg can be negative (produce less) or positive (produce more)
    # Physical output: Q_phys[g,h] = Q_prev[g,h] + Qg[g,h]
    Qg = m.ext[:variables][:Qg] = @variable(m, Qg[g in IG, h in JH])

    # Storage variables
    has_storage = m.ext[:parameters][:has_storage]
    if has_storage
        E_cap = m.ext[:parameters][:storage_energy_capacity]
        P_cap = m.ext[:parameters][:storage_power_capacity]
        η = m.ext[:parameters][:storage_efficiency]
        
        # Qch[h] = charging power in hour h [MW]
        # Qdis[h] = discharging power in hour h [MW]
        # SOC[h] = state of charge at end of hour h [MWh]
        Qch = m.ext[:variables][:Qch] = @variable(m, 0 <= Qch[h in JH] <= P_cap)
        Qdis = m.ext[:variables][:Qdis] = @variable(m, 0 <= Qdis[h in JH] <= P_cap)
        SOC = m.ext[:variables][:SOC] = @variable(m, 0 <= SOC[h in JH] <= E_cap)
        SOC_init = m.ext[:parameters][:storage_initial_soc]
    end

    # OBJECTIVE: maximise welfare (value of demand minus generation cost)
    # Settled at current market clearing price for actual physical output
    # Q_phys[g,h] = Q_prev[g,h] + Qg[g,h] = actual dispatch
    m.ext[:objective] = @objective(m, Max,
        sum(Pr_dem[(String(d),h)] * Qd[d,h] for d in ID, h in JH) -
        sum(Pr_gen[(String(g),h)] * (Q_prev[(String(g),h)] + Qg[g,h]) for g in IG, h in JH)
    )

    # energy balance: in each hour, total PHYSICAL generation equals total served demand
    # Q_phys[g,h] = Q_prev[g,h] + Qg[g,h] = actual dispatch
    # if storage, add storage charging/discharging
    if has_storage
        m.ext[:constraints][:energy_balance] = @constraint(
            m, [h in JH],
            sum(Q_prev[(String(g),h)] + Qg[g,h] for g in IG) + Qdis[h] - Qch[h] - sum(Qd[d,h] for d in ID) == 0
        )
    else
        m.ext[:constraints][:energy_balance] = @constraint(
            m, [h in JH],
            sum(Q_prev[(String(g),h)] + Qg[g,h] for g in IG) - sum(Qd[d,h] for d in ID) == 0
        )
    end

    # generator adjustment limits:
    # Hour 1: no adjustment (commitment is fixed from previous clearing)
    m.ext[:constraints][:gen_commitment_hour1] = @constraint(
        m, [g in IG],
        Qg[g, 1] == 0
    )
    
    # Hours 2+: can adjust up or down within physical bounds
    # Physical output Q_phys = Q_prev + Qg must satisfy: 0 <= Q_phys <= Q_gen
    # Lower bound: Q_prev + Qg >= 0  =>  Qg >= -Q_prev
    # Upper bound: Q_prev + Qg <= Q_gen  =>  Qg <= Q_gen - Q_prev
    m.ext[:constraints][:gen_limits_lower] = @constraint(
        m, [g in IG, h in JH; h > 1],
        Qg[g, h] >= -Q_prev[(String(g), h)]
    )
    m.ext[:constraints][:gen_limits_upper] = @constraint(
        m, [g in IG, h in JH; h > 1],
        Qg[g, h] <= Q_gen[(String(g), h)] - Q_prev[(String(g), h)]
    )

    # demand limits: served demand cannot exceed maximum quantity Q_dem[d,h]
    m.ext[:constraints][:dem_limits] = @constraint(
        m, [d in ID, h in JH],
        Qd[d,h] <= Q_dem[(String(d),h)]
    )

    # Storage constraints
    if has_storage
        η = m.ext[:parameters][:storage_efficiency]
        
        # State of charge dynamics: SOC[h] = SOC[h-1] + η*Qch[h] - Qdis[h]/η
        # For first hour h=1, use initial SOC
        @constraint(m, SOC[1] == SOC_init + η * Qch[1] - Qdis[1] / η)
        
        for h in 2:length(JH)
            @constraint(m, SOC[h] == SOC[h-1] + η * Qch[h] - Qdis[h] / η)
        end
        # End SOC is left free (no constraint)
    end

    return m
end

# ============================================================================
# SECTION 4: ROLLING HORIZON SIMULATION
# ============================================================================

begin  # Create local scope to avoid variable shadowing

# Declare all loop variables as local explicitly
local clearing_count, m, Qg_val, Qd_val, λ, prev_commitments, SOC_val

cfg = YAML.load_file("input_data_rolling.yaml")

# Extract rolling horizon parameters
rh_params = get(cfg, "rolling_horizon", Dict())
sim_days = Int(get(rh_params, "simulation_days", 7))
look_ahead = Int(get(rh_params, "look_ahead_window", 24))
reclear_freq = Int(get(rh_params, "reclear_frequency", 1))
forecast_noise = float(get(rh_params, "forecast_noise_std", 0.05))

total_hours = sim_days * 24

println("=== Rolling Horizon Market Clearing ===")
println("Simulation period: $sim_days days ($total_hours hours)")
println("Look-ahead window: $look_ahead hours")
println("Reclear frequency: every $reclear_freq hour(s)")
println("Forecast noise std: $forecast_noise")
println()

# Load the base data structure
data = load_input_data("input_data.yaml")

# Load and expand time series for entire simulation
Pr_gen_full, Q_gen_full, Pr_dem_full, Q_dem_full = load_and_expand_timeseries(cfg, total_hours)

# Initialize sets and parameters (these stay the same across all windows)
m_template = Model(HiGHS.Optimizer)
define_sets!(m_template, data)
IG = m_template.ext[:sets][:IG]
ID = m_template.ext[:sets][:ID]

# Storage for results across all clearings
all_results = Dict{Symbol,Any}()
all_results[:clearing_times] = Int[]
all_results[:prices] = Dict{Int, Vector{Float64}}()          # prices[clearing] = [λ per hour]
all_results[:dispatch] = Dict{Int, Dict}()                   # dispatch[clearing][generator] = values
all_results[:executed_dispatch] = Dict{String, Vector{Float64}}()  # final executed values
all_results[:executed_prices] = Float64[]                    # what prices materialized

# Initialize executed dispatch tracking
for g in IG
    all_results[:executed_dispatch][g] = Float64[]
end

# Initialize previous commitments (first clearing: all hours start at 0)
prev_commitments = Dict{Tuple{String,Int},Float64}()
for g in IG
    for h in 1:look_ahead
        prev_commitments[(g, h)] = 0.0
    end
end

# Main rolling horizon loop
clearing_count = 0
for start_hour in 0:reclear_freq:(total_hours - look_ahead)
    clearing_count += 1
    current_hour = start_hour + 1  # Convert to 1-indexed
    
    println("--- Clearing $clearing_count: Current hour = $current_hour (Global hour $(start_hour+1)) ---")
    
    # Extract window time series
    Pr_gen_window, Q_gen_window, Pr_dem_window, Q_dem_window = get_window_timeseries(
        Pr_gen_full, Q_gen_full, Pr_dem_full, Q_dem_full,
        current_hour, look_ahead, IG, ID
    )
    
    # Add forecast noise (optional)
    if forecast_noise > 0.0
        add_wind_forecast_noise!(Q_gen_window, cfg, forecast_noise, IG, look_ahead)
    end
    
    # Create new model for this window
    m = Model(HiGHS.Optimizer)
    set_silent(m)  # Suppress HiGHS solver output
    
    # Define sets and parameters for this window
    define_sets!(m, data)
    
    # Manually populate time series for this window (instead of calling process_time_series_data!)
    m.ext[:sets][:JH] = 1:look_ahead
    
    # Prepare Q_prev: first hour is locked to previous commitment
    Q_prev = prepare_Q_prev_for_next_window(prev_commitments, look_ahead, IG)
    
    # Store time series for this window
    m.ext[:timeseries] = Dict{Symbol,Any}()
    m.ext[:timeseries][:Pr_gen] = Pr_gen_window
    m.ext[:timeseries][:Q_gen] = Q_gen_window
    m.ext[:timeseries][:Pr_dem] = Pr_dem_window
    m.ext[:timeseries][:Q_dem] = Q_dem_window
    m.ext[:timeseries][:Q_prev] = Q_prev
    
    # Process parameters
    process_parameters!(m, data)
    
    # Build and solve
    build_market_clearing!(m)
    optimize!(m)
    
    status = termination_status(m)
    if status != OPTIMAL
        println("Non-optimal termination: $status")
    else
        println("Solved to optimality")
    end
    
    # Extract results
    Qg_val = value.(m.ext[:variables][:Qg])
    Qd_val = value.(m.ext[:variables][:Qd])
    
    # Extract prices
    λ = dual.(m.ext[:constraints][:energy_balance])
    prices_window = [λ[h] for h in 1:look_ahead]
    
    # Store results
    push!(all_results[:clearing_times], current_hour)
    all_results[:prices][clearing_count] = prices_window
    all_results[:dispatch][clearing_count] = Dict(g => [Qg_val[g, h] for h in 1:look_ahead] for g in IG)
    
    # Execute first hour: store actual dispatch and price
    for g in IG
        push!(all_results[:executed_dispatch][g], Qg_val[g, 1])
    end
    push!(all_results[:executed_prices], prices_window[1])
    
    # Extract commitments for next window (all 24 hours, financially settled)
    prev_commitments = extract_window_commitments(Qg_val, IG, look_ahead)
    
    println("  First-hour price: $(round(prices_window[1]; digits=2)) EUR/MWh")
    
    # Optional: storage state continuity
    if m.ext[:parameters][:has_storage]
        SOC_val = value.(m.ext[:variables][:SOC])
        # Store SOC at end of first hour for next window (TODO: implement in next clearing)
    end
end

println()
println("=== Simulation Complete ===")
println("Total clearings: $clearing_count")
println("Total executed hours: $(length(all_results[:executed_prices]))")
println()

# Summary statistics
avg_price = mean(all_results[:executed_prices])
println("Average executed price: $(round(avg_price; digits=2)) EUR/MWh")
println("Min executed price: $(round(minimum(all_results[:executed_prices]); digits=2)) EUR/MWh")
println("Max executed price: $(round(maximum(all_results[:executed_prices]); digits=2)) EUR/MWh")

#--------------------------
# Visualization of rolling horizon results
function plot_rolling_horizon_results(all_results::Dict)
    executed_prices = all_results[:executed_prices]
    hours = 1:length(executed_prices)
    
    p1 = plot(hours, executed_prices, 
              xlabel="Hour of Simulation", ylabel="Price (EUR/MWh)",
              title="Executed Market-Clearing Prices (Rolling Horizon)",
              marker=:circle, linewidth=2, label="Price", legend=:topright)
    hline!(p1, [mean(executed_prices)], label="Average", ls=:dash, color=:red)
    
    # Plot dispatch of Base and Wind if available
    Base_gen = [all_results[:executed_dispatch]["Base"][h] for h in 1:length(executed_prices)]
    Wind_gen = [all_results[:executed_dispatch]["Wind"][h] for h in 1:length(executed_prices)]
    
    p2 = plot(hours, Base_gen, 
              xlabel="Hour of Simulation", ylabel="Generation (MW)",
              title="Executed Dispatch - Base Generator",
              label="Base", linewidth=2)
    
    p3 = plot(hours, Wind_gen,
              xlabel="Hour of Simulation", ylabel="Generation (MW)",
              title="Executed Dispatch - Wind Generator",
              label="Wind", linewidth=2, color=:green)
    
    plot(p1, p2, p3, layout=(3,1), size=(1000, 800))
end

# Plot rolling horizon results
plot_rolling_horizon_results(all_results)

#--------------------------
# End of rolling horizon simulation

end  # End of local scope block