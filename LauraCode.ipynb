    "using JuMP\n",
    "\n",
    "include(\"lib/data_importer.jl\")\n",
    "include(\"lib/market_clearers/clear_market.jl\")\n",
    "\n",
    "data = DataImporter.load_input_data(\"configs/rolling_config.yaml\")\n",
    "println(data)\n",
    "ClearMarket.Clear(data)\n",
    "\n",
    "println(\"done\")\n"
   ]
